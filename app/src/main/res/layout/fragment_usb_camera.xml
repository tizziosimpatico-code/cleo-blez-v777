<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/cameraSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.cleo.blebridge.RoiOverlayView
        android:id="@+id/roiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#AA000000"
        android:padding="16dp">

        <TextView
            android:id="@+id/textUsbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔌 In attesa della webcam USB..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetectedSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocità rilevata: --"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 NON AVVIATO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonDetectUsb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RILEVA WEBCAM" />

            <Button
                android:id="@+id/buttonResetRoi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="RIDISEGNA ZONA" />

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="START" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="STOP" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--- log ---"
                android:textColor="#00FF00"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </ScrollView>

    </LinearLayout>

</FrameLayout>
